# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
tab_width = 4
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{ts,js}]
quote_type = double

[*.json]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{mc,mss,jungle}]
indent_style = tab
tab_width = 4
indent_size = 4
max_line_length = 120

# Use 2 spaces for YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2
